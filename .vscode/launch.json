{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Q3RTX: RTX Debug (Meson Debug)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/meson-debug/q3rtx.x64.exe",
      "args": [
        "+set",
        "fs_basepath",
        "C:/Program Files (x86)/Steam/steamapps/common/Quake 3 Arena",
        "+set",
        "fs_homepath",
        "${workspaceFolder}/.q3home",
        "+set",
        "cl_renderer",
        "rtx",
        "+set",
        "rtx_rt_mode",
        "2",
        "+set",
        "rtx_rt_require",
        "1",
        "+set",
        "rtx_rt_dynamic_blas",
        "1",
        "+set",
        "rtx_rt_sun_intensity",
        "2.5",
        "+set",
        "rtx_rt_async_overlap",
        "0",
        "+set",
        "rtx_rt_dynamic_resolution",
        "0",
        "+set",
        "r_fbo",
        "1",
        "+set",
        "rtx_rt_debug_visualizer",
        "0",
        "+set",
        "com_ignoreErrorInterrupt",
        "1",
        "+set",
        "logfile",
        "2",
        "+set",
        "r_fullscreen",
        "0",
        "+set",
        "cg_shadows",
        "0",
        "+devmap",
        "q3dm1"
      ],
      "cwd": "C:/Program Files (x86)/Steam/steamapps/common/Quake 3 Arena",
      "preLaunchTask": "meson: build rtx debug",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Q3RTX: RTX Debug (Meson Release)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/meson-release/q3rtx.x64.exe",
      "args": [
        "+set",
        "fs_basepath",
        "C:/Program Files (x86)/Steam/steamapps/common/Quake 3 Arena",
        "+set",
        "fs_homepath",
        "${workspaceFolder}/.q3home",
        "+set",
        "cl_renderer",
        "rtx",
        "+set",
        "rtx_rt_mode",
        "2",
        "+set",
        "rtx_rt_require",
        "1",
        "+set",
        "rtx_rt_dynamic_blas",
        "1",
        "+set",
        "rtx_rt_sun_intensity",
        "2.5",
        "+set",
        "rtx_rt_async_overlap",
        "0",
        "+set",
        "rtx_rt_dynamic_resolution",
        "0",
        "+set",
        "r_fbo",
        "1",
        "+set",
        "rtx_rt_debug_visualizer",
        "0",
        "+set",
        "com_ignoreErrorInterrupt",
        "1",
        "+set",
        "logfile",
        "2"
      ],
      "cwd": "C:/Program Files (x86)/Steam/steamapps/common/Quake 3 Arena",
      "preLaunchTask": "meson: build rtx release",
      "stopAtEntry": false,
      "console": "internalConsole"
    }
  ]
}
